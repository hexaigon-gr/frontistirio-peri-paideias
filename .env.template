# Canonical public origin (sitemap.xml, robots.txt, canonical links, OG tags)
#
# The exact public origin: scheme + host, no trailing slash, no path. It is the
# www host and not the apex because that is the direction the redirect runs:
# frontistirio-peripaideias.gr answers 308 to www. Point this at the redirect
# TARGET, never at the host that redirects, or every canonical link and every
# sitemap URL lands on a redirect.
#
# NEVER replace this with a *.vercel.app deployment URL, and never invent a
# value if the origin ever changes. A wrong canonical origin gets indexed and is
# hard to unwind, so a pasted *.vercel.app value FAILS the build on purpose.
#
# Leaving it unset is a legitimate state, not a broken one: `pnpm dev` then uses
# http://localhost:3000 and a production build still SUCCEEDS, but ships
# deliberately unindexable (robots.txt disallows everything, sitemap.xml empty,
# every page noindex/nofollow, JSON-LD omitted) with a loud warning in the log.
#
# This must match the value in the Vercel project env vars. Changing it there
# needs a REDEPLOY, because env vars do not apply to an existing deployment.
NEXT_PUBLIC_SITE_URL=https://www.frontistirio-peripaideias.gr

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
# NEXTAUTH_URL is the origin NextAuth builds its callback URLs from, so in
# production it is the canonical origin above, not localhost.
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Configuration
# Get these from https://console.developers.google.com/apis/credentials
# Create an OAuth 2.0 Client ID
# Authorized redirect URIs, both of them:
#   http://localhost:3000/api/auth/callback/google
#   https://www.frontistirio-peripaideias.gr/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase Database Configuration
# Get these from your Supabase project settings > Database
# Connect to Supabase via Shared Connection Pooler (for production)
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database through Shared Pooler (supports IPv4/IPv6). Used for migrations.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# If your network supports IPv6 or you purchased IPv4 addon, use dedicated pooler (optional)
# DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"